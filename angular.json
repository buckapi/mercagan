{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "mercagan-site": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "assets/**/*",
                "input": "plantilla",
                "output": "/"
              }
            ],
            "styles": [
              "plantilla/assets/css/bootstrap.min.css",
              "plantilla/assets/css/all.min.css",
              "plantilla/assets/css/animate.css",
              "plantilla/assets/css/magnific-popup.css",
              "plantilla/assets/css/meanmenu.css",
              "plantilla/assets/css/swiper-bundle.min.css",
              "plantilla/assets/css/nice-select.css",
              "plantilla/assets/css/main.css",
              "src/styles.css"
            ],
            "scripts": [
              "plantilla/assets/js/jquery-3.7.1.min.js",
              "plantilla/assets/js/bootstrap.bundle.min.js",
              "plantilla/assets/js/swiper-bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "fonts": {
                  "inline": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mercagan-site:build:production"
            },
            "development": {
              "buildTarget": "mercagan-site:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
